PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Default: persistent embedded PostgreSQL in server/data.
# To use an existing PostgreSQL server, uncomment:
# DB_CONNECTION_STRING=postgresql://user:password@localhost:5432/ecommerce
# Opt-in versioned catalog: 21 products, three per category.
# Runs once; preserves edited/custom products and does not restore deleted samples:
SEED_DEMO=true

